package partials

import (
	"context"
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
)

type ApplicationHealthBadgeInput struct {
	Status     string
	StatusCode *int
}

func applicationHealthBadgeClass(status string) string {
	switch status {
	case "online":
		return "bg-emerald-400 ring-emerald-100/40 shadow-[0_0_10px_rgba(52,211,153,0.75)]"
	case "warning":
		return "bg-amber-300 ring-amber-100/40 shadow-[0_0_10px_rgba(252,211,77,0.75)]"
	case "offline":
		return "bg-rose-500 ring-rose-100/40 shadow-[0_0_10px_rgba(244,63,94,0.7)]"
	default:
		return "bg-tertiary/40 ring-tertiary/20 animate-pulse"
	}
}

templ ApplicationHealthBadge(input ApplicationHealthBadgeInput) {
	<span
		class={ "inline-flex h-3 w-3 shrink-0 rounded-full ring-2 " + applicationHealthBadgeClass(input.Status) }
		title={ applicationHealthBadgeTitle(ctx, input) }
		aria-label={ applicationHealthBadgeTitle(ctx, input) }
	></span>
}

func applicationHealthBadgeTitle(ctx context.Context, input ApplicationHealthBadgeInput) string {
	label := i18n.T(ctx, "applications.health." + input.Status)
	if input.StatusCode != nil {
		return fmt.Sprintf("%s (%d)", label, *input.StatusCode)
	}
	return label
}
